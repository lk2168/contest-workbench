# 本地密钥与产物
.env
out/
data/

# Python
__pycache__/
*.pyc
.venv/
venv/

# 提交信息临时文件（我用 -F 传多行信息时会产生，别提交）
.git-msg-*.txt

# PyInstaller 打包产物：exe 是二进制，不进版本库
# （要分发给用户就发到 GitHub Release，而不是提交进仓库）
build/
dist/
*.spec


# 发布时临时用的说明文件（正式副本放 docs/releases/）
.release-notes-*.md

# pip 本地安装产生的构建元数据（pip install . 会生成，别提交）
*.egg-info/
.eggs/

# 我干活时的临时脚本（.tmp-*.py），不属于项目文件
.tmp-*.py
